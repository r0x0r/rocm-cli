+/// What the model list needs to know about this machine, probed once so the
+/// renderer does not repeat a probe that can spawn a subprocess.
+struct ModelListHost {
+    /// Dedicated VRAM in GiB; `None` unless a discrete card reported it.
+    dedicated_vram_gib: Option<f64>,
+    /// Installed system RAM in GiB.
+    ram_gib: Option<f64>,
+    /// The host gfx target, used to mark the hardware group that is this GPU.
+    gfx_target: Option<String>,
+}
+
+/// Memory figures used to mark which listed models fit this machine.
+///
+/// VRAM is only reported for a discrete card: on an APU `amd-smi` names the BIOS
+/// carve-out, the wrong pool (see [`classify_accelerator_memory`]), so the
+/// model list falls back to system RAM there. The list is advisory, so
+/// installed RAM is acceptable as an estimate; `rocm diagnose --model` stays
+/// the authority on whether one model will actually run.
+fn host_memory_for_model_list() -> ModelListHost {
+    let vram = gpu_vram_usage();
+    let gfx_target = detect_host_gfx_target();
+    let dedicated_vram_gib = match classify_accelerator_memory(
+        vram.as_deref(),
+        gfx_target.as_deref(),
+        true,
+        rocm_core::usable_amd_gpu_indices().as_deref(),
+    ) {
+        AcceleratorMemory::Dedicated(gib) => Some(gib),
+        _ => None,
+    };
+    ModelListHost {
+        dedicated_vram_gib,
+        ram_gib: rocm_core::detect_system_ram_gib(),
+        gfx_target,
+    }
+}
