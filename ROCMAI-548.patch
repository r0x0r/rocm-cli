+/// The quant or memory note shown beside a model in the list.
+fn model_recipe_detail(recipe: &ModelRecipeRecord) -> String {
+    recipe
+        .quantization
+        .clone()
+        .unwrap_or_else(|| model_recipe_memory_label(recipe))
+}
+
+/// Whether a recipe fits the host's memory, or `None` when that cannot be told.
+///
+/// Dedicated VRAM, when known, is the budget. Otherwise (an APU, or a host
+/// where VRAM could not be read) system RAM is, since an integrated GPU draws
+/// its memory from it.
+fn model_recipe_fits_host(
+    recipe: &ModelRecipeRecord,
+    dedicated_vram_gib: Option<f64>,
+    host_ram_gib: Option<f64>,
+) -> Option<bool> {
+    if let Some(available) = dedicated_vram_gib {
+        return Some(
+            recipe
+                .min_gpu_mem_gb
+                .is_none_or(|required| available >= f64::from(required)),
+        );
+    }
+    let available = host_ram_gib?;
+    recipe
+        .recommended_system_ram_gb
+        .or(recipe.min_gpu_mem_gb)
+        .map(|required| available >= f64::from(required))
+}
+
+/// The per-row fit label, or `None` when the host's memory is unknown (a
+/// verdict on every row would then read "unknown", which is noise).
+fn model_recipe_host_fit_label(
+    recipe: &ModelRecipeRecord,
+    dedicated_vram_gib: Option<f64>,
+    host_ram_gib: Option<f64>,
+) -> Option<&'static str> {
+    if dedicated_vram_gib.is_some() {
+        return Some(model_recipe_gpu_fit_label(recipe, dedicated_vram_gib));
+    }
+    model_recipe_fits_host(recipe, None, host_ram_gib).map(|fits| {
+        if fits {
+            "fits this machine's memory"
+        } else {
+            "needs more memory than this machine has"
+        }
+    })
+}
