+// Copyright © Advanced Micro Devices, Inc., or its affiliates.
+//
+// SPDX-License-Identifier: MIT
+
+//! Steps for `model_list.feature`.
+//!
+//! The machine's memory is simulated by planting a `/proc/meminfo` under a
+//! directory the scenario owns and pointing the CLI's hardware probes at it. That
+//! redirection exists only in a `rocm` built with the `e2e-test-hooks` feature,
+//! which is what `cargo xtask e2e` builds. The scenarios are gated to hosts with
+//! no AMD GPU, where system memory is the whole budget, so nothing else the CLI
+//! measures can change the answer.
+
+use cucumber::{given, then, when};
+
+use crate::E2eWorld;
+
+/// The environment variable that re-roots the CLI's hardware probes in a build
+/// with the `e2e-test-hooks` feature. Black-box: named here, not imported.
+const HOST_ROOT_ENV: &str = "ROCM_CLI_TEST_HOST_ROOT";
+
+/// Heading of the block that leads the list with the models that fit.
+const FITS_HEADING: &str = "Fits this machine:";
+/// Line printed instead of that block when nothing fits.
+const NOTHING_FITS_LINE: &str = "No recommended model fits this machine's memory";
+/// Suffix of a row in the hardware groups whose model fits.
+const ROW_FITS: &str = "fits this machine's memory";
+/// Suffix of a row in the hardware groups whose model does not.
+const ROW_TOO_LARGE: &str = "needs more memory than this machine has";
+
+/// The one featured model small enough for a 16 GiB machine.
+const SMALL_MODEL: &str = "Qwen3-4B-Instruct-2507-GGUF";
+/// Featured models that need more than 16 GiB.
+const TOO_LARGE_MODELS: [&str; 2] = ["Qwen3.6-35B-A3B", "gemma-4-26B-A4B"];
+
+/// Said when the planted memory did not reach the CLI, so a binary built without
+/// the hook is named as the cause instead of reading as a wrong model list.
+const HOOK_HINT: &str = "If this line is missing or shows this runner's real memory, the `rocm` \
+     under test was built without the `rocm/e2e-test-hooks` feature, which is what lets the \
+     suite plant a simulated machine. `cargo xtask e2e` builds it that way; a prebuilt \
+     ROCM_CLI_BINARY must too.";
+
+// ── Given ──────────────────────────────────────────────────────────
+
+#[given(expr = "a machine with {int} GiB of memory")]
+async fn machine_with_memory(world: &mut E2eWorld, gib: u64) {
+    let host = world
+        .isolated_root
+        .as_ref()
+        .expect("no isolated root")
+        .path()
+        .join("host");
+    let proc_dir = host.join("proc");
+    std::fs::create_dir_all(&proc_dir).expect("failed to create simulated /proc");
+    // `/proc/meminfo` reports MemTotal in kB (KiB).
+    std::fs::write(
+        proc_dir.join("meminfo"),
+        format!("MemTotal:       {} kB\n", gib * 1024 * 1024),
+    )
+    .expect("failed to write simulated /proc/meminfo");
+    world
+        .command_env
+        .push((HOST_ROOT_ENV, host.into_os_string()));
+}
+
+// ── When ───────────────────────────────────────────────────────────
+
+#[when("the user lists the recommended models")]
+async fn user_lists_models(world: &mut E2eWorld) {
+    let (stdout, stderr, rc) = crate::run_rocm_with_scenario_env(world, &["model"]);
+    world.cli_output = Some(stdout);
+    world.cli_stderr = Some(stderr);
+    world.cli_rc = Some(rc);
+}
+
+/// Asks the CLI the question the list points to for the first model it offers.
+/// Replaces the recorded list with the answer; the model asked about is kept in
+/// `model_name`.
+#[when("the user asks whether the first model offered as fitting would run")]
+async fn user_asks_about_first_fitting_model(world: &mut E2eWorld) {
+    let model = {
+        let out = listing(world);
+        let fits = fits_block(out)
+            .unwrap_or_else(|| panic!("the list has no `{FITS_HEADING}` block:\n{out}"));
+        fits.first()
+            .copied()
+            .and_then(|row| row.split_whitespace().next())
+            .unwrap_or_else(|| panic!("the `{FITS_HEADING}` block lists no model:\n{out}"))
+            .to_owned()
+    };
+    let (stdout, stderr, rc) = crate::run_rocm(world, &["diagnose", "--model", &model, "--json"]);
+    world.model_name = Some(model);
+    world.cli_output = Some(stdout);
+    world.cli_stderr = Some(stderr);
+    world.cli_rc = Some(rc);
+}
+
+// ── Then ───────────────────────────────────────────────────────────
+
+#[then(expr = "the list reports {int} GiB of system memory")]
+async fn list_reports_memory(world: &mut E2eWorld, gib: u64) {
+    let out = listing(world);
+    let expected = format!("This machine: {gib} GiB system memory");
+    assert!(
+        out.lines().any(|line| line.trim() == expected),
+        "expected the line `{expected}` in the list. {HOOK_HINT}\n{out}"
+    );
+}
+
+#[then("the small model is listed as fitting this machine")]
+async fn small_model_fits(world: &mut E2eWorld) {
+    let out = listing(world);
+    assert!(
+        !out.contains(NOTHING_FITS_LINE),
+        "the list says nothing fits, yet a small model should:\n{out}"
+    );
+    let fits = fits_block(out)
+        .unwrap_or_else(|| panic!("the list has no `{FITS_HEADING}` block:\n{out}"));
+    assert!(
+        fits.iter().any(|row| row.trim_start().starts_with(SMALL_MODEL)),
+        "{SMALL_MODEL} is not in the `{FITS_HEADING}` block: {fits:?}\n{out}"
+    );
+    // The same verdict has to appear where the model sits among its hardware
+    // group, or the two parts of the list disagree.
+    assert!(
+        rows_ending_with(out, ROW_FITS)
+            .iter()
+            .any(|row| row.contains(SMALL_MODEL)),
+        "{SMALL_MODEL} is not marked `{ROW_FITS}` in its hardware group:\n{out}"
+    );
+}
+
+#[then("the models too large for this machine are not listed as fitting")]
+async fn large_models_do_not_fit(world: &mut E2eWorld) {
+    let out = listing(world);
+    let fits = fits_block(out).unwrap_or_default();
+    let marked_fitting = rows_ending_with(out, ROW_FITS);
+    for model in TOO_LARGE_MODELS {
+        assert!(
+            !fits.iter().any(|row| row.contains(model)),
+            "{model} needs more than this machine has but is in the `{FITS_HEADING}` block: \
+             {fits:?}\n{out}"
+        );
+        assert!(
+            !marked_fitting.iter().any(|row| row.contains(model)),
+            "{model} needs more than this machine has but is marked `{ROW_FITS}`:\n{out}"
+        );
+    }
+}
+
+#[then("the models too large for this machine are marked as needing more memory")]
+async fn large_models_are_marked(world: &mut E2eWorld) {
+    let out = listing(world);
+    let marked = rows_ending_with(out, ROW_TOO_LARGE);
+    for model in TOO_LARGE_MODELS {
+        assert!(
+            marked.iter().any(|row| row.contains(model)),
+            "{model} is not marked `{ROW_TOO_LARGE}`:\n{out}"
+        );
+    }
+}
+
+#[then("the user is told no recommended model fits this machine")]
+async fn told_nothing_fits(world: &mut E2eWorld) {
+    let out = listing(world);
+    assert!(
+        out.lines().any(|line| line.starts_with(NOTHING_FITS_LINE)),
+        "expected a line starting `{NOTHING_FITS_LINE}`:\n{out}"
+    );
+}
+
+#[then("no model is listed as fitting this machine")]
+async fn no_model_fits(world: &mut E2eWorld) {
+    let out = listing(world);
+    assert!(
+        fits_block(out).is_none(),
+        "the list has a `{FITS_HEADING}` block though nothing should fit:\n{out}"
+    );
+    let marked_fitting = rows_ending_with(out, ROW_FITS);
+    assert!(
+        marked_fitting.is_empty(),
+        "rows are marked `{ROW_FITS}` though nothing should fit: {marked_fitting:?}\n{out}"
+    );
+}
+
+#[then("every recommended model is marked as needing more memory")]
+async fn every_model_is_marked(world: &mut E2eWorld) {
+    let out = listing(world);
+    // Guard against a vacuous pass: with no marks at all, "none fits" would hold
+    // for a list that simply never judged any model.
+    assert!(
+        !rows_ending_with(out, ROW_TOO_LARGE).is_empty(),
+        "no model is marked `{ROW_TOO_LARGE}`:\n{out}"
+    );
+}
+
+#[then("the CLI recognises that model as one of its recommendations")]
+async fn cli_recognises_model(world: &mut E2eWorld) {
+    let model = world.model_name.clone().expect("no model was asked about");
+    let stdout = world.cli_output.clone().unwrap_or_default();
+    let stderr = world.cli_stderr.clone().unwrap_or_default();
+    assert_eq!(
+        world.cli_rc,
+        Some(0),
+        "`rocm diagnose --model {model}` failed (it is a query and should exit 0):\n{stdout}\n{stderr}"
+    );
+    assert!(
+        !stderr.contains("unexpected argument") && !stderr.contains("Usage:"),
+        "`rocm diagnose --model {model}` was rejected as a malformed command:\n{stderr}"
+    );
+    let report: serde_json::Value = serde_json::from_str(&stdout)
+        .unwrap_or_else(|error| panic!("diagnose --json did not emit JSON ({error}):\n{stdout}"));
+    let section = report
+        .get("model")
+        .filter(|value| !value.is_null())
+        .unwrap_or_else(|| panic!("diagnose --model emitted no model section:\n{stdout}"));
+    assert_eq!(
+        section
+            .get("canonical_model_id")
+            .and_then(serde_json::Value::as_str),
+        Some(model.as_str()),
+        "the CLI did not match `{model}` to a recommendation: {section:#}"
+    );
+    assert_ne!(
+        section
+            .get("undetermined_reason")
+            .and_then(serde_json::Value::as_str),
+        Some("model_not_curated"),
+        "the CLI calls `{model}` a model it has no recommendation for: {section:#}"
+    );
+}
+
+// ── Helpers ────────────────────────────────────────────────────────
+
+/// The stdout of the recorded `rocm model`, after checking it succeeded.
+fn listing(world: &E2eWorld) -> &str {
+    let rc = world.cli_rc.expect("no command rc recorded");
+    let out = world.cli_output.as_deref().unwrap_or("");
+    assert_eq!(
+        rc,
+        0,
+        "`rocm model` failed (rc={rc}):\n{out}\n{}",
+        world.cli_stderr.as_deref().unwrap_or("")
+    );
+    out
+}
+
+/// The rows under the `Fits this machine:` heading, which end at the first blank
+/// line. `None` when the list has no such heading.
+fn fits_block(out: &str) -> Option<Vec<&str>> {
+    let mut lines = out.lines().skip_while(|line| line.trim() != FITS_HEADING);
+    lines.next()?;
+    Some(lines.take_while(|line| !line.trim().is_empty()).collect())
+}
+
+/// The list's lines whose last words are `label`: the per-model verdicts in the
+/// hardware groups. Matching the end of the line keeps the "nothing fits" notice
+/// and the usage examples at the foot of the list out of the result.
+fn rows_ending_with<'a>(out: &'a str, label: &str) -> Vec<&'a str> {
+    out.lines()
+        .filter(|line| line.trim_end().ends_with(label))
+        .collect()
+}
