+    #[test]
+    fn render_model_registry_text_offers_small_models_on_a_16_gib_host() {
+        // ROCMAI-548: a 16 GiB integrated-GPU host used to see only 17-62 GiB
+        // models. Without dedicated VRAM, system RAM is the budget.
+        let rendered = render_model_registry_text_with_context_and_host(None, None, Some(16.0));
+
+        assert!(rendered.contains("This machine: 16 GiB system memory"));
+        let fits = fits_this_machine_block(&rendered);
+        assert!(fits.contains("Qwen3-4B-Instruct-2507-GGUF"), "{fits}");
+        assert!(!fits.contains("Qwen3.6-27B"), "{fits}");
+        assert!(!fits.contains("gemma-4"), "{fits}");
+        // The larger models stay listed but are marked as too large.
+        assert!(rendered.contains("unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M"));
+        assert!(rendered.contains("needs more memory than this machine has"));
+        assert!(rendered.contains("fits this machine's memory"));
+    }
+
