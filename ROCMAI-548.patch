+    /// The "Fits this machine" block of a rendered model list.
+    fn fits_this_machine_block(rendered: &str) -> &str {
+        let start = rendered
+            .find("Fits this machine:")
+            .expect("fit section should be present");
+        let rest = &rendered[start..];
+        rest.split("\n\n").next().unwrap_or(rest)
+    }
